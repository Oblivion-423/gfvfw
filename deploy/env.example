# ==========================================================================
# GFVFW 生产环境变量
#
# 安装：
#   sudo install -d -m 750 /etc/gfvfw
#   sudo cp deploy/env.example /etc/gfvfw/env
#   sudo chmod 600 /etc/gfvfw/env
#
# ⚠️ 本文件里**只有 GFVFW_SECRET_KEY 一行需要改** —— 其余默认值已经是
#    为 /srv/gfvfw 这套部署写好的。所以不必开编辑器（最小化安装的
#    Alibaba Cloud Linux / CentOS 往往没有 nano），直接替换那一行即可：
#
#     KEY=$(python3 -c "import secrets; print(secrets.token_urlsafe(48))")
#     sudo sed -i "s|^GFVFW_SECRET_KEY=.*|GFVFW_SECRET_KEY=${KEY}|" /etc/gfvfw/env
#
#    （密钥是 urlsafe base64，只含 A-Za-z0-9-_，所以用 | 当分隔符是安全的）
#
#    想用编辑器的话：dnf install -y nano  或直接用 vi
#
# ⚠️ 这个文件含密钥，权限 600、属主 root，绝不入库（.gitignore 已排除 .env*）。
# ==========================================================================

# ---- 必改：会话/CSRF 密钥 ----
# 生成： python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 留默认值等于所有人的会话都能被伪造。
GFVFW_SECRET_KEY=CHANGE-ME-用上面命令生成

# ---- 必开：会话 Cookie 只走 HTTPS ----
# ⚠️ 不设成 true 的话，会话 Cookie 没有 Secure 属性：用户任何一次
#    走 http:// 的请求（旧书签/手输域名/被降级）都会明文带上它，
#    而那次请求发生在 Caddy 跳转到 HTTPS 之前，代理救不了。
GFVFW_HTTPS_ONLY=true

# ---- 可信反向代理 ----
# 只有来自这些地址的 X-Forwarded-For 会被采信（见 services/audit.py）。
# 默认仅回环，与应用只监听 127.0.0.1 的部署一致。
GFVFW_TRUSTED_PROXY_IPS=127.0.0.1,::1

# ---- 数据目录（必须与 gfvfw.service 的 ReadWritePaths 一致）----
GFVFW_DATABASE_URL=sqlite+pysqlite:////srv/gfvfw/var/gfvfw.sqlite3
GFVFW_STORAGE_DIR=/srv/gfvfw/var/storage
GFVFW_BACKUP_DIR=/srv/gfvfw/var/backups
GFVFW_BACKUP_KEEP_DAYS=30

# ---- 战役管理：BMS 剧场数据 ----
# ⚠️ 服务器**不需要安装 BMS**，只要把剧场数据表拷过来（必需部分共 47.9 MB）。
#    文件清单与体积见 docs/requirements.md §7.3.1。
#    留空则 .cam 上传会明确报错（不会写入半空的存档）。
GFVFW_BMS_INSTALL_PATH=/srv/gfvfw/bms-data

# ---- 剧场底图（态势图的背景图）----
# BMS 自带的**全部**底图有 1.6 GB，别整套拷；但每个剧场那张 4K 图只要 7~14 MB，
# 拷上去就够了 —— 这是线上态势图有没有背景图的分水岭。
# 在开发机上一条命令备好（挑图 + 可选降采样 + 给出 rsync 命令）：
#   .venv/Scripts/python.exe scripts/collect_theater_maps.py \
#       --out var/maps --rsync gfvfw@你的VPS
# 文件名必须含剧场名（Hellas.png / korea.png …），否则多剧场混放会张冠李戴。
# 必须是**正方形**、边长 ≥1024。
GFVFW_BMS_MAP_DIR=/srv/gfvfw/bms-data/maps

# ---- /enroll（直接开队员账号）----
# 默认 **true（公开）**：拿到 /enroll 链接的人不需要登录、不需要任何权限，
# 可以给自己开一个立刻生效的队员账号 —— 这是联队口径。
# ⚠️ 公开 ⇒ **链接本身就是凭证**：泄漏链接 = 泄漏一个队员名额（能看队内全部
#    内容并提交数据）；「不在导航里」不是安全措施（地址固定在源码里）。
#    要收回公开（恢复为"需要 application.review 权限"），改成 false 并重启。
GFVFW_ENROLL_OPEN=true

# 同一个来源 IP 每天最多通过 /enroll 开几个账号。
# 默认给得宽：联队集体入队常常共用一个出口 IP。
GFVFW_MAX_ENROLL_PER_IP_PER_DAY=20

# ---- 站点 ----
GFVFW_SITE_NAME=矛隼虚拟飞行联队
GFVFW_SITE_ABBR=GFVFW
